  "description": "A theme-aware Claude Code-inspired startup header for Pi.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi-header",
    "crisp-header",
    "tui"
  ],
  "license": "MIT",
  "author": "ZoLive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zo-Live/pi-crisp-header.git"
  },
  "homepage": "https://github.com/Zo-Live/pi-crisp-header#readme",
  "bugs": {
    "url": "https://github.com/Zo-Live/pi-crisp-header/issues"
  },
  "type": "module",
  "exports": {
